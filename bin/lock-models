#!/usr/bin/env python3
"""Create a reviewed release lock for upstream model archives, without installing them."""
import hashlib
import json
from pathlib import Path
import urllib.request

result = {}
for pair in ("en_ru", "ru_en"):
    url = f"https://argos-net.com/v1/translate-{pair}-1_9.argosmodel"
    digest = hashlib.sha256()
    size = 0
    with urllib.request.urlopen(url, timeout=30) as response:
        while block := response.read(1024 * 1024):
            size += len(block)
            if size > 1024 * 1024 * 1024:
                raise RuntimeError("Model archive exceeds size limit")
            digest.update(block)
    result[pair] = dict(url=url, version="1.9", sha256=digest.hexdigest(), size=size)
path = Path(__file__).resolve().parents[1] / "models.lock.json"
path.write_text(json.dumps(result, indent=2) + "\n")
print(path)
